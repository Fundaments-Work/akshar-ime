<?xml version="1.0" encoding="UTF-8"?>
<!-- Akshar Devanagari IME: one phonetic engine, one input source per language.
     Every source runs the same engine; the language only conditions ranking.
     The engine name's suffix is the language code (src/ibus_engine.c). -->
<component>
    <name>org.freedesktop.IBus.AksharDevanagari</name>
    <description>Akshar Devanagari Input Method Engine</description>
    <exec>/usr/lib/ibus/engines/devanagari-smart --ibus</exec>
    <version>1.3.0</version>
    <author>Sabin</author>
    <license>MIT</license>
    <homepage>https://github.com/sapienskid/akshar-ime</homepage>
    <textdomain>devanagari-smart</textdomain>
    <engines>
        <!-- Auto: ranks language-blind across every Devanagari language. -->
        <engine>
            <name>devanagari-smart</name>
            <longname>Devanagari (Akshar)</longname>
            <description>Phonetic Devanagari for every language written in the script</description>
            <language>ne</language>
            <license>MIT</license>
            <author>Sabin</author>
            <icon>/usr/share/icons/hicolor/scalable/apps/ibus-keyboard.svg</icon>
            <layout>us</layout>
            <rank>50</rank>
        </engine>
        <engine>
            <name>devanagari-smart-hi</name>
            <longname>Hindi — हिन्दी (Akshar)</longname>
            <description>Phonetic Devanagari, suggestions ranked for Hindi</description>
            <language>hi</language>
            <license>MIT</license>
            <author>Sabin</author>
            <icon>/usr/share/icons/hicolor/scalable/apps/ibus-keyboard.svg</icon>
            <layout>us</layout>
            <rank>40</rank>
        </engine>
        <engine>
            <name>devanagari-smart-ne</name>
            <longname>Nepali — नेपाली (Akshar)</longname>
