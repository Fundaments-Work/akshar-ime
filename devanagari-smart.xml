<?xml version="1.0" encoding="UTF-8"?>
<!-- Akshar Nepali IME: one phonetic engine, one input source.
     The engine ships Nepali-only priors, so there is a single input source
     and no language suffix to parse (src/ibus_engine.c). -->
<component>
    <name>org.freedesktop.IBus.AksharNepali</name>
    <description>Akshar Nepali Input Method Engine</description>
    <exec>/usr/lib/ibus/engines/devanagari-smart --ibus</exec>
    <version>1.2.0</version>
    <author>Sabin</author>
    <license>MIT</license>
    <homepage>https://github.com/Fundaments-Work/akshar-ime</homepage>
    <textdomain>devanagari-smart</textdomain>
    <engines>
        <engine>
            <name>devanagari-smart</name>
            <longname>Nepali — नेपाली (Akshar)</longname>
            <description>Phonetic Nepali input from Roman keystrokes</description>
            <language>ne</language>
            <license>MIT</license>
            <author>Sabin</author>
            <icon>/usr/share/icons/hicolor/scalable/apps/ibus-keyboard.svg</icon>
            <layout>us</layout>
            <rank>50</rank>
        </engine>
    </engines>
</component>
